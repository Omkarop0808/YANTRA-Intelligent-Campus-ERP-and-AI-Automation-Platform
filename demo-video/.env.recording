# Recording-only environment overrides (NO SECRETS stored here).
# Used by demo-video/prepare.sh to run Express and FastAPI against isolated yantra_demo DB
# with elevated rate limits (so Scene 2 setup does not hit 429) and dry-run external alerts.

MONGODB_URI=mongodb://127.0.0.1:27017/yantra_demo
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_WRITE_MAX=1000
CHAT_RATE_LIMIT=1000/minute
WHATSAPP_DRY_RUN=true
VAPI_DRY_RUN=true
REQUIRE_TOOL_APPROVAL=true
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.6-flash
