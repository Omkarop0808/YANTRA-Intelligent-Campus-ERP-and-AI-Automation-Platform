# Benchmark environment overrides for stress testing
# Used by benchmarks/load_test.py to avoid 429 rate limit saturation during concurrency testing
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=100000
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=100000
RATE_LIMIT_WRITE_WINDOW_MS=60000
CHAT_RATE_LIMIT=100000/minute
