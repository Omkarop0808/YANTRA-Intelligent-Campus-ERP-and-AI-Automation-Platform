{
  "name": "yantra-backend",
  "version": "1.0.0",
  "description": "Yantra ERP authentication and academic management backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && NODE_ENV=test MONGODB_URI=mongodb://127.0.0.1:27017/yantra_test_unit JWT_SECRET=test-only-jwt-secret-key-for-unit-tests-123456 RATE_LIMIT_ENABLED=false node --test dist/tests/*.test.js",
    "seed:admin": "ts-node-dev --transpile-only src/scripts/seed-admin.ts",
    "seed:demo": "ts-node-dev --transpile-only src/scripts/seed-demo.ts",
    "seed:quizzes": "ts-node-dev --transpile-only src/scripts/seed-quizzes.ts",
    "seed:announcements": "ts-node-dev --transpile-only src/scripts/seed-announcements.ts",
    "seed:grade-batch": "ts-node-dev --transpile-only src/scripts/seed-grade-batch.ts",
    "seed:attendance": "ts-node-dev --transpile-only src/scripts/seed-attendance.ts",
    "seed:student-data": "ts-node-dev --transpile-only src/scripts/seed-student-data.ts",
    "seed:all": "npm run seed:admin && npm run seed:demo && npm run seed:quizzes && npm run seed:announcements && npm run seed:grade-batch && npm run seed:attendance && npm run seed:student-data"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.15.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
