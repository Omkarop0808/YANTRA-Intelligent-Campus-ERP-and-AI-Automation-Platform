# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/yantra_erp

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_MINUTES=1

# Logging
LOG_LEVEL=info

# Bootstrap admin (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_NAME=Admin Console

# Storage (Set to 'local' to store uploaded PDFs in ./uploads, or provide Cloudinary credentials)
CLOUDINARY_CLOUD_NAME=local
CLOUDINARY_API_KEY=local
CLOUDINARY_API_SECRET=local
CLOUDINARY_FOLDER=yantra_erp/resources
