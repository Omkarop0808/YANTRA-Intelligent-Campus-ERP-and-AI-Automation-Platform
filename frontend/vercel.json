{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://yantra-express-api.onrender.com/api/:path*"
    },
    {
      "source": "/python-app/:path*",
      "destination": "https://yantra-python-ai.onrender.com/python-app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}